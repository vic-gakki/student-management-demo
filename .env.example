# 不设置 DATABASE_URL 时使用本地 PGlite（嵌入式 PostgreSQL，数据存放在 .data/pglite）
# 部署时设置为 Neon 等 PostgreSQL 连接串
DATABASE_URL=

# ── AI（可选）：不配置时两处 AI 功能自动降级，系统其余功能照常工作 ──
# 协议：anthropic（默认）| openai（OpenAI 及兼容服务：DeepSeek、通义千问、Ollama、vLLM…）
LLM_PROVIDER=anthropic
LLM_MODEL=claude-haiku-5-5
# 通用 key；未设置时分别回退到 ANTHROPIC_API_KEY / OPENAI_API_KEY
LLM_API_KEY=
# 自定义地址：Anthropic 兼容网关，或 OpenAI 兼容服务（例如 https://api.deepseek.com/v1、http://localhost:11434/v1）
LLM_BASE_URL=
# 仅 openai 协议：OpenAI 新模型需要 max_completion_tokens；部分兼容服务不认识 strict 字段时设为 false
# LLM_MAX_TOKENS_FIELD=max_completion_tokens
# LLM_STRICT_TOOLS=false

# 兼容旧配置：只设置这一项等同于 LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
